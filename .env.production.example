# Public HTTPS host served directly by the bundled Caddy edge.
CELTRONICS_DOMAIN=shop.example.com

# Durable host directory. Create it before the first start and make it writable
# by the non-root application container (node user, uid/gid 1000 in the image).
CELTRONICS_DATA_ROOT=/srv/celtronics

# Required production session secrets. Generate independent random values.
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-different-long-random-secret

# Required only while an active ADMIN record has no passwordHash.
# After the first successful bootstrap login, this may be removed.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password

# Optional quote-notification SMTP. Leave all core values blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Optional payment providers. Keep disabled in the admin control plane until
# the matching production credentials have been configured and verified.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_TRANSFER_RECIPIENT=
BANK_TRANSFER_ACCOUNT_NUMBER=
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
