# Local development
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Admin bootstrap (development / controlled bootstrap only)
# Required only while an active ADMIN record has no passwordHash.
# The first successful bootstrap login seals this password as bcrypt in the DB.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Persistent storage
# Development may omit these and use repository-local fallbacks.
# Production MUST set both paths to a durable, writable volume.
CELTRONICS_DB_PATH=./var/celtronics/db.json
CELTRONICS_UPLOAD_ROOT=./var/celtronics/uploads
# Optional backup directory; defaults to a backups/ directory next to CELTRONICS_DB_PATH.
CELTRONICS_DB_BACKUP_DIR=./var/celtronics/backups

# Optional file-store lock tuning (milliseconds)
# Defaults: retry=25, timeout=15000, stale=10000, heartbeat=2000,
# warn-wait=500, slow-transaction=1000.
CELTRONICS_DB_LOCK_RETRY_MS=25
CELTRONICS_DB_LOCK_TIMEOUT_MS=15000
CELTRONICS_DB_LOCK_STALE_MS=10000
CELTRONICS_DB_LOCK_HEARTBEAT_MS=2000
CELTRONICS_DB_LOCK_WARN_WAIT_MS=500
CELTRONICS_DB_SLOW_TX_MS=1000

# Stripe (optional as a feature, but all values are required together in production)
# NEXT_PUBLIC_APP_URL must be an HTTPS origin in production, without a path/query/hash.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Manual bank transfer (optional provider; both values are required before it can be enabled)
# Use a Polish 26-digit account number; spaces and an optional PL prefix are accepted.
BANK_TRANSFER_RECIPIENT=
BANK_TRANSFER_ACCOUNT_NUMBER=

# Przelewy24 (optional provider, disabled by default)
# In production NEXT_PUBLIC_APP_URL must be a clean HTTPS origin.
# Production payment capture uses secure.przelewy24.pl and verifies urlStatus
# notifications with SHA-384 plus transaction/verify before marking PAID.
# Enabling the provider also performs GET /api/v1/testAccess before settings are persisted.
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
